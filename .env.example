# Run sh scripts/bootstrap.sh to generate secrets inside Docker without printing them.
ADMIN_TOKEN=
APP_ORIGIN=http://localhost:3100
HOST=127.0.0.1
PORT=3100
DATA_DIR=data

# Disabled until your real accounts are configured and the previews reviewed.
LIVE_PUBLISH=false
AUTO_APPROVE=false
RESEARCH_SCHEDULE_ENABLED=false
# Optional: only needed for VPS-driven research, not ChatGPT MCP submissions.
OPENAI_API_KEY=
# Select a model available to your API account that supports Responses web_search.
OPENAI_MODEL=

# Local Postiz API endpoint; Docker overrides this to the internal service URL.
POSTIZ_API_URL=http://localhost:4007/api/public/v1
POSTIZ_API_KEY=
INSTAGRAM_INTEGRATION_ID=
INSTAGRAM_PROVIDER=instagram-standalone
POSTIZ_IMAGE=ghcr.io/gitroomhq/postiz-app:v2.23.0
POSTIZ_PUBLIC_URL=http://localhost:4007
POSTIZ_JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_PASSWORD=
DISABLE_REGISTRATION=true
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# WAHA group IDs end in @g.us. Channels end in @newsletter.
WAHA_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_CHAT_ID=
WAHA_DASHBOARD_PASSWORD=
# Pinned image; account pairing must still be validated with your WhatsApp account.
WAHA_IMAGE=devlikeapro/waha@sha256:527ff3d634925adb26d596883d7b3ca502c080f737af3c2af2be0c973c511533

# For the optional Caddy production profile. Point DNS at your VPS first.
APP_DOMAIN=events.example.com
POSTIZ_DOMAIN=social.example.com

# Optional: a short domain you own (e.g. kurejam.lv) pointing at this server. Captions use it for
# short links; without it they use the dashboard's own host, which serves the same links.
SHORT_LINK_BASE=

# Optional: an ej.uz API key from your own ej.uz account. Published events then get ej.uz short
# links in captions, falling back to the app's own links if ej.uz refuses one or is unavailable.
EJUZ_API_KEY=

# Footage for animated edits (dashboard uploads, see docs/chatgpt-video.md). Processing and rendering run
# on this server's CPU, so raise these with care.
FOOTAGE_MAX_MB=1024
FOOTAGE_MAX_SECONDS=600
# Depth made on this server (make_depth): the longest clip it will do, and how much detail the model sees
# (the shorter side in pixels; 392 is quick, 518 is the model's full detail at about twice the time).
# The model (about 100 MB) downloads from Hugging Face on first use; DEPTH_MODEL can point at a local copy.
DEPTH_MAX_SECONDS=120
DEPTH_DETAIL=392

# Generated sound: voiceover, sound effects and music from ElevenLabs (speak, make_sound_effect,
# make_music). Without a key those tools refuse and everything else works as before.
ELEVENLABS_API_KEY=
# Which speech model. Blank uses eleven_multilingual_v2; a flash or turbo model is about half the
# credits a character and a little flatter.
ELEVENLABS_MODEL=
# The voice used when a narration style has no voice pinned to it (set_style_voice does the pinning).
ELEVENLABS_VOICE=
# The most credits this server will let the account reach. Blank means 80% of the plan's allowance, so
# there is always some left for your own use in the ElevenLabs app. On Creator (121,000 a month) the
# default ceiling is 96,800.
ELEVENLABS_CREDIT_CAP=
